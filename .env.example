# Copy to .env and fill in. Never commit .env.
APP_ENV=production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
# Your domain (VPS + Caddy only)
DOMAIN=codequest.example.com

# Database: docker-compose builds DATABASE_URL from these. On Railway, set DATABASE_URL instead.
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# First instructor account, created on start-up if it doesn't exist
ADMIN_NAME=Pratik Patil
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-strong

# Email for OTP codes
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=CodeQuest <no-reply@codequest.example.com>

# Code judge
JUDGE_TIME_LIMIT=3
JUDGE_MEMORY_MB=512
